---
layout: default
---
<div class="hy-page{% if page.page_class %} {{ page.page_class }}{% endif %}">
  <header class="hy-page-header">
    {% if page.eyebrow %}
      <p class="hy-label">{{ page.eyebrow }}</p>
    {% endif %}
    <h1>{{ page.heading | default: page.title }}</h1>
    {% if page.description %}
      <p class="hy-page-intro">{{ page.description }}</p>
    {% endif %}
  </header>
  {{ content }}
</div>
